{
  "name": "clean-architecture",
  "description": "A Node template following the Clean Architecture principles and encouraging established practices.",
  "author": "Oussama Trabelsi",
  "license": "MIT",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "tsx watch src/web/server | pino-pretty",
    "lint": "tsc --noEmit && eslint .",
    "test": "jest",
    "test:unit": "jest --selectProjects unit-tests",
    "test:functional": "jest --selectProjects functional-tests",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/autoload": "^6.0.3",
    "@fastify/awilix": "^7.0.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/swagger": "^9.4.1",
    "@fastify/swagger-ui": "^5.2.1",
    "@fastify/type-provider-json-schema-to-ts": "^5.0.0",
    "@prisma/client": "^6.2.1",
    "awilix": "^12.0.4",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "helmet": "^8.0.0",
    "pino": "^9.6.0",
    "prisma": "^6.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.1",
    "@types/jest": "^29.5.14",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "dotenv": "^16.4.7",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-mock-extended": "^4.0.0-beta1",
    "lint-staged": "^15.3.0",
    "pg": "^8.13.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "template",
    "fastify",
    "clean-architecture",
    "typescript"
  ]
}
